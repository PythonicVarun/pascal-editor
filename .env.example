# Optional environment variables — the editor works without any of these

# Google Maps API key (enables address search)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Dev server port (default: 3000)
# PORT=3000

# Agent mode — agent runner sidecar (services/agent-runner). Defaults to
# http://localhost:4000. Override when the sidecar runs on another host.
# AGENT_RUNNER_URL=http://localhost:4000

# Browser-facing origin for the sidecar. The browser connects DIRECTLY to this
# (not through Next.js rewrites) so that WebSocket upgrades for ttyd and
# socket.io work in dev — Next.js rewrites don't proxy WS. In production
# behind a reverse proxy, set this to the proxied path.
# NEXT_PUBLIC_AGENT_RUNNER_URL=http://localhost:4000

# Absolute host path bind-mounted into agent containers as $PASCAL_DATA_DIR
# (default /pascal-data). Both the Next.js editor process and the container's
# pascal-mcp resolve their SQLite DB under this directory, so MCP mutations
# reach the editor's SSE stream.
# NEXT_PUBLIC_PASCAL_DATA_DIR_HOST=/home/codespace/.pascal/data

# Set AGENT_IMAGE=pascal-agent:latest in services/agent-runner/.env to use the
# Pascal-aware overlay image (bun + @pascal-app/mcp + per-agent MCP config).
# Build it with `bun run setup:pascal-agent` (chained from setup:agent-runner).
